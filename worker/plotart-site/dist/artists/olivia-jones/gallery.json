  "practice": "Visual Artist",
  "slug": "olivia-jones",
  "statement": "Olivia Jones’ practice pairs hard-edge geometric abstraction with linear perspective. Using sharp, converging lines and vanishing points, she constructs passages, thresholds, and otherworldly spaces that create tension between rigid, calculated geometry and organic, gestural underlayers.",
  "website": "https://www.oliviajonesart.com/"
 },
